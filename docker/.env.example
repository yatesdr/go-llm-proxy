# Copy this file to .env and fill in a password to bootstrap the admin
# console on first run — no need to hand-edit config.yaml just to log in.
#
# Only used when config.yaml doesn't already set admin_password /
# usage_dashboard_password — a value in config.yaml always wins.
#
# Setting GO_LLM_ADMIN_PASSWORD alone is enough to log into /admin — no other
# config.yaml changes required for that.

GO_LLM_ADMIN_PASSWORD=

# Optional. /usage (the usage dashboard) needs its own password and its own
# `usage_dashboard: true` in config.yaml — GO_LLM_ADMIN_PASSWORD does not
# unlock it. Set this to give /usage a login without touching config.yaml.
# If usage_dashboard: true is set but this is left blank, /admin (only)
# falls back to using it as its password too.
GO_LLM_USAGE_DASHBOARD_PASSWORD=
